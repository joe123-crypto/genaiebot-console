diff --git a/workspace/lib/test_campaign_captions.py b/workspace/lib/test_campaign_captions.py
new file mode 100644
index 0000000..4f2190e
--- /dev/null
+++ b/workspace/lib/test_campaign_captions.py
@@ -0,0 +1,119 @@
+"""Caption edits survive write/read and reach preview and sending without I/O."""
+import datetime
+import importlib.machinery
+import importlib.util
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+LIB = Path(__file__).resolve().parent
+sys.path.insert(0, str(LIB))
+import operator_config as oc
+import operator_writer as ow
+import promo_broadcast as pb
+from test_operator_writer import Harness
+
+
+def read_bridge():
+    loader = importlib.machinery.SourceFileLoader("caption_test_bridge", str(LIB.parent / "bin/console-read"))
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    bridge = importlib.util.module_from_spec(spec)
+    loader.exec_module(bridge)
+    return bridge
+
+
+class CaptionChanges(Harness):
+    def setUp(self):
+        super().setUp()
+        self.env["GENAIE_CONFIG_SOURCE"] = "firestore"
+
+    def loaded(self):
+        return oc.load(self.env, opener=self.firestore,
+                       signer=lambda *args: "jwt", now=lambda: self.clock[0],
+                       sleep=lambda s: None, log=lambda message: None)
+
+    def test_edit_add_delete_are_persisted_and_audited(self):
+        for captions in (["First {bot_number}", "Second {ref_link}"],
+                         ["Changed 💧\n\n{ref_link}", "Second {ref_link}", "Third"],
+                         ["Third"]):
+            with self.subTest(captions=captions):
+                before = self.stored("campaigns", "cv")
+                result = self.write("campaigns", "cv", {"captions": captions})
+                self.assertTrue(result["audit"])
+                self.assertEqual(self.stored("campaigns", "cv")["captions"], captions)
+                self.assertEqual(self.stored("campaigns", "cv")["rank"], before["rank"])
+                loaded = self.loaded()
+                source = {"mode": "firestore", "membership": loaded["membership"]}
+                self.assertEqual(oc.campaign_captions(source, "cv", ["Shipped"]), captions)
+
+    def test_invalid_copy_is_refused_before_any_commit(self):
+        for captions in ([], "text", [""], [" \n"], ["valid", None], ["💧" * 20000]):
+            with self.subTest(captions=captions):
+                with self.assertRaises(ow.WriteRefused):
+                    self.write("campaigns", "cv", {"captions": captions})
+                self.assertEqual(self.firestore.commits, [])
+
+    def test_file_and_shadow_modes_cannot_claim_to_save_live_captions(self):
+        for mode in ("file", "shadow", ""):
+            self.env["GENAIE_CONFIG_SOURCE"] = mode
+            with self.assertRaisesRegex(ow.WriteRefused, "requires GENAIE_CONFIG_SOURCE"):
+                self.write("campaigns", "cv", {"captions": ["Edited"]})
+        self.assertEqual(self.firestore.commits, [])
+
+    def test_preview_and_campaign_list_use_the_saved_templates(self):
+        captions = ["New 💧 {bot_number}\n\n{ref_link}"]
+        self.write("campaigns", "cv", {"captions": captions})
+        loaded = self.loaded()
+        bridge = read_bridge()
+        bridge._RESOLVED["config"] = {"mode": "firestore", "membership": loaded["membership"],
+                                       "switches": loaded["enabled"]}
+        day = datetime.date(2026, 11, 6)
+        record = next(row for row in bridge.campaign_records(day) if row["slug"] == "cv")
+        self.assertEqual(record["captions"], captions)
+        self.assertEqual(record["source"], "console")
+        preview = bridge.preview("cv", day)
+        self.assertEqual(preview["captions"], captions)
+        self.assertTrue(preview["groups"])
+        for group in preview["groups"]:
+            self.assertEqual(group["variant"], 0)
+            self.assertTrue(group["caption"].startswith("New 💧"))
+            self.assertNotIn("{bot_number}", group["caption"])
+            self.assertNotIn("{ref_link}", group["caption"])
+
+    def test_no_override_keeps_shipped_copy_and_file_mode_rolls_back(self):
+        source = {"mode": "firestore", "membership": self.loaded()["membership"]}
+        self.assertEqual(oc.campaign_captions(source, "cv", ["Shipped"]), ["Shipped"])
+        source["membership"]["promos"]["cv"]["captions"] = ["Edited"]
+        source["mode"] = "file"
+        self.assertEqual(oc.campaign_captions(source, "cv", ["Shipped"]), ["Shipped"])
+
+    def test_a_future_broadcast_sends_the_saved_copy_after_variant_deletion(self):
+        self.write("campaigns", "cv", {"captions": ["Edited 💧 {ref}"]})
+        loaded = self.loaded()
+        source = {"mode": "firestore", "membership": loaded["membership"],
+                  "enabled": True, "switches": loaded["enabled"], "doc": {"groups": ["123@g.us"]}}
+        image = os.path.join(self.dir, "ad.png")
+        Path(image).write_bytes(b"test image")
+        sent = []
+        def send(jid, text, image_path, account=None):
+            sent.append(text)
+            return True, '{"messageId":"test"}'
+        with patch.object(pb, "send_ad", side_effect=send):
+            result = pb.broadcast(
+                text=["Shipped first", "Shipped second"], image=image,
+                targets_file=os.path.join(self.dir, "targets.json"),
+                state_file=os.path.join(self.dir, "state.json"), promo_name="cv-promo",
+                variant_images={1: image}, tracking={"prefix": "CV", "number": "+10000000001"},
+                resolve_config=lambda *args, **kwargs: source, argv=[],
+                caps=None, account_status=lambda accounts: {account: True for account in accounts},
+                send_delay=0, start_jitter=0, cron_timeout=None)
+        self.assertEqual(result, 0)
+        self.assertEqual(len(sent), 1)
+        self.assertTrue(sent[0].startswith("Edited 💧 CV-"), sent)
+        self.assertNotIn("{ref}", sent[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
