+def validate_tracking(tracking):
+    """Same tracking contract for creation, editing, previews and posting."""
+    import re
+    if (not isinstance(tracking, dict) or
+            set(tracking) - {"prefix", "label", "number", "prefill", "link_line"} or
+            any(not isinstance(value, str) or len(value) > 1000 for value in tracking.values())):
+        raise ConfigInvalid("invalid tracking settings")
+    if tracking:
+        if not re.fullmatch(r"[A-Za-z0-9-]{1,64}", tracking.get("prefix", "")):
+            raise ConfigInvalid("tracking requires a ref prefix")
+        if tracking.get("number") and not re.fullmatch(r"\+[1-9][0-9]{6,14}", tracking["number"]):
+            raise ConfigInvalid("use an international contact number")
+    return dict(tracking)
+
+
+def campaign_tracking(source, slug, fallback):
+    meta = ((source.get("membership") or {}).get("promos") or {}).get(slug) or {}
+    return validate_tracking(meta["tracking"]) if "tracking" in meta else fallback
+
