+"""Posting/preview parity and safe tracking edits, without live services."""
+import datetime
+import os
+import re
+import unittest
+from unittest.mock import patch
+
+from test_console_read import BridgeCase, DAY
+import campaign_clicks
+import operator_config
+import operator_writer
+import promo_broadcast
+import promo_fixture
+
+
+class TrackedPreviewTests(BridgeCase):
+    def test_preview_reuses_the_posting_redirect_without_counting_a_click(self):
+        env = self.bridge_env(GENAIE_CAMPAIGN_CLICK_BASE_URL="https://click.example.test")
+        with patch.dict(os.environ, env, clear=True):
+            base = campaign_clicks.base_url()
+            self.assertIsNotNone(base)
+            preview = self.ok("preview", "alpha", "--date", DAY,
+                              GENAIE_CAMPAIGN_CLICK_BASE_URL=base)
+            store = campaign_clicks.ClickStore()
+            wrapper = promo_broadcast.campaign_link_wrapper(preview["tracking"], "alpha")
+            for row in preview["groups"]:
+                number = row["contactNumber"]
+                _, caption, _ = promo_broadcast.caption_for(
+                    row["jid"], preview["captions"], day=datetime.date.fromisoformat(DAY),
+                    tracking=preview["tracking"], bot_number=number,
+                    wrap_link=lambda destination: wrapper(row["jid"], row["name"], destination))
+                self.assertEqual(caption, row["caption"])
+                link_id = re.search(r"/go/([a-f0-9]+)", caption).group(1)
+                self.assertTrue(store.destination(link_id).startswith("https://wa.me/"))
+            self.assertEqual(store.report("alpha")["totalClicks"], 0)
+            link_id = re.search(r"/go/([a-f0-9]+)", preview["groups"][0]["caption"]).group(1)
+            store.increment(link_id)
+            self.assertEqual(store.report("alpha")["totalClicks"], 1)
+            again = self.ok("preview", "alpha", "--date", DAY, GENAIE_CAMPAIGN_CLICK_BASE_URL=base)
+            self.assertEqual(preview["groups"], again["groups"])
+            self.assertEqual(store.report("alpha")["totalClicks"], 1)
+
+    def test_unconfigured_tracking_keeps_direct_link_fallback(self):
+        preview = self.ok("preview", "alpha", "--date", DAY, GENAIE_CAMPAIGN_CLICK_BASE_URL="")
+        self.assertTrue(all("https://wa.me/" in row["caption"] for row in preview["groups"]))
+
+
+class TrackingEditsTests(unittest.TestCase):
+    def test_writer_prepares_captions_and_destination_as_one_change(self):
+        config = promo_fixture.membership()
+        raw = {name: [(key, operator_config.encode_fields(value)) for key, value in rows]
+               for name, rows in operator_writer.documents(config, {slug: True for slug in config["promos"]}).items()}
+        tracking = {"prefix": "ALPHA", "number": "+26370000003"}
+        fields, before, _, _ = operator_writer.prepare(raw, "campaigns", "alpha", {
+            "captions": ["Offer {ref_link}"], "tracking": tracking})
+        self.assertEqual(fields["tracking"], tracking)
+        self.assertEqual(fields["captions"], ["Offer {ref_link}"])
+        self.assertNotEqual(before["tracking"], tracking)
+        source = {"membership": {"promos": {"alpha": fields}}}
+        self.assertEqual(operator_config.campaign_tracking(source, "alpha", {}), tracking)
+
+    def test_refuses_invalid_destinations_and_preserves_template_settings(self):
+        tracking = {"prefix": "ALPHA", "number": "+26370000003", "prefill": "Hello {ref}", "link_line": "Chat {ref_link}"}
+        self.assertEqual(operator_config.validate_tracking(tracking), tracking)
+        for invalid in ({"number": "+26370000003"}, {"prefix": "A", "number": "123"}, {"prefix": "A", "url": "https://bad.test"}):
+            with self.assertRaises(operator_config.ConfigInvalid):
+                operator_config.validate_tracking(invalid)
+
+
+if __name__ == "__main__":
+    unittest.main()
