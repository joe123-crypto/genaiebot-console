+def campaign_link_wrapper(tracking, campaign):
+    """One redirect renderer for posting and console previews.
+
+    Registering a preview reuses the same durable destination as a send. It
+    never increments a count; only the public redirect handler does that.
+    """
+    try:
+        base = campaign_clicks.base_url() if tracking else None
+    except ValueError:
+        sys.stderr.write("WARN: Invalid campaign click base URL; using direct WhatsApp links.\n")
+        base = None
+    if not base:
+        return None
+    store = campaign_clicks.ClickStore()
+    return partial(_tracked_link, base, store, campaign)
+
