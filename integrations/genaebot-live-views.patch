diff --git a/workspace/lib/console_live_api.py b/workspace/lib/console_live_api.py
new file mode 100644
index 0000000..016c48c
--- /dev/null
+++ b/workspace/lib/console_live_api.py
@@ -0,0 +1,294 @@
+"""Small authenticated display endpoints over the shared local index."""
+import base64
+import datetime
+import hashlib
+import importlib.machinery
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import re
+import sqlite3
+import threading
+import time
+from urllib.parse import parse_qs
+from zoneinfo import ZoneInfo
+
+import console_live_index
+import group_discovery
+import group_metrics
+
+PAGE_SIZE = 10
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def title(slug):
+    return " ".join(part.upper() if part in ("cv", "it", "ict", "ai", "r2") else part.capitalize() for part in slug.split("-"))
+
+
+def cursor_encode(value):
+    return base64.urlsafe_b64encode(json.dumps(value).encode()).decode().rstrip("=")
+
+
+def cursor_decode(value):
+    try:
+        if len(value) > 4096:
+            raise ValueError()
+        return json.loads(base64.urlsafe_b64decode(value + "=" * (-len(value) % 4)))
+    except Exception as exc:
+        raise ValueError("Invalid page cursor.") from exc
+
+
+class LiveViews:
+    def __init__(self, bridge_path, env=None, *, index=None):
+        self.env = dict(os.environ if env is None else env)
+        self.index = index or console_live_index.Index(self.env)
+        loader = importlib.machinery.SourceFileLoader("console_live_read", str(bridge_path))
+        spec = importlib.util.spec_from_loader(loader.name, loader)
+        self.bridge = importlib.util.module_from_spec(spec)
+        loader.exec_module(self.bridge)
+        self.lock = threading.RLock()
+        self.writes_active = 0
+        self.write_fence = None
+        self.cache = None
+        self.cache_at = 0
+        self.sql = sqlite3.connect(":memory:", check_same_thread=False)
+        self.sql.execute("CREATE TABLE rows(kind TEXT,id TEXT,position INTEGER,body TEXT,PRIMARY KEY(kind,id))")
+
+    def begin_write(self):
+        with self.lock:
+            self.writes_active += 1
+
+    def fence(self):
+        with self.lock:
+            self.writes_active = max(0, self.writes_active - 1)
+            self.write_fence = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
+            self.cache = None
+            self.index.touch()
+
+    def close(self):
+        self.index.close()
+        with self.lock:
+            self.sql.close()
+
+    def _model(self):
+        if self.writes_active:
+            raise console_live_index.NotReady("Waiting for the active write.")
+        config, revision = self.index.snapshot()
+        if self.write_fence:
+            if datetime.datetime.fromisoformat(config["fetchedAt"].replace("Z", "+00:00")) < datetime.datetime.fromisoformat(self.write_fence.replace("Z", "+00:00")):
+                raise console_live_index.NotReady("Waiting for the committed changes to reach the display index.")
+            self.write_fence = None
+        now = time.time()
+        day = datetime.datetime.now(ZoneInfo("Africa/Harare")).date()
+        signature = (revision, str(day))
+        # Local histories may change cap allowances without a config write.
+        if self.cache and self.cache[0] == signature and now - self.cache_at < 30:
+            return self.cache[1]
+        bridge = self.bridge
+        bridge._RESOLVED.clear()
+        bridge._RESOLVED["config"] = bridge.promo_config.resolve(
+            None, env=self.env, membership_path=bridge.MEMBERSHIP,
+            config_loader=lambda *args, **kwargs: config, err=io.StringIO())
+        groups = bridge.group_rows(day)
+        campaigns = bridge.campaign_records(day, include_assets=False)
+        # No image catalogue reads. List copy is a count, not downloaded captions.
+        for row in campaigns:
+            row["captionCount"] = len(row.get("captions", []))
+            row.pop("captions", None)
+            row.pop("images", None)
+            row.pop("assets", None)
+            row.pop("script", None)
+        def band(row):
+            return 0 if row["status"] != "active" else 1 if row["promos"] else 2
+        groups.sort(key=lambda row: (band(row), row["jid"]))
+        campaigns.sort(key=lambda row: (row["hour"] if row["hour"] is not None else 99, row["minute"] or 0, row["slug"]))
+        self.sql.execute("DELETE FROM rows")
+        for kind, rows, key in (("groups", groups, "jid"), ("campaigns", campaigns, "slug")):
+            self.sql.executemany("INSERT INTO rows VALUES(?,?,?,?)", [
+                (kind, row[key], i, json.dumps(row)) for i, row in enumerate(rows)])
+        self.sql.commit()
+        model = {"date": str(day), "groups": groups, "campaigns": campaigns, "config": config,
+                 "context": {"accounts": bridge.accounts(config["membership"]),
+                    "capSettings": bridge.cap_settings(config["membership"]),
+                    "writes": bridge.write_capabilities(), "actions": bridge.action_capabilities()},
+                 "disabledPromos": sorted(bridge.disabled_promos(bridge.manifest(), day))}
+        self.cache = (signature, model)
+        self.cache_at = now
+        return model
+
+    def handle(self, route, query):
+        values = parse_qs(query, keep_blank_values=True)
+        if any(len(v) != 1 for v in values.values()):
+            raise ValueError("Repeated query parameters are not supported.")
+        params = {k: v[0] for k, v in values.items()}
+        allowed = {"q", "status", "line", "campaign", "tier", "cadence", "slot", "cursor", "anchor", "since", "ids", "slug"}
+        if set(params) - allowed or len(params.get("q", "")) > 512:
+            raise ValueError("Invalid display query.")
+        if route not in ("metrics", "discoveries"):
+            self.index.touch()
+        elif self.index.thread is not None:
+            with self.index.condition:
+                self.index.lease_until = self.index.clock() + console_live_index.LEASE_SECONDS
+        self.index.counters["indexedRequests"] += 1
+        with self.lock:
+            if route == "metrics":
+                return self.metrics(params)
+            if route == "status":
+                return {"sync": self.index.status(), "counters": dict(self.index.counters)}
+            if route == "discoveries":
+                membership = self.index.observation_membership(include_ids=True)
+                result = group_discovery.read(membership, self.env)
+                rows = result.get("discoveredGroups", [])
+                rows.sort(key=lambda row: (row["name"] or "", row["jid"]))
+                return self.page("discoveries", rows, params, digest(result), self.index.status(),
+                                 {"discovery": result.get("groupDiscovery")})
+            model = self._model()
+            sync = self.index.status()
+            if route == "navigation":
+                return {"sync": sync, "campaignTotal": len(model["campaigns"]),
+                        "groupsNeedingReview": sum(row["status"] != "active" for row in model["groups"])}
+            if route == "settings":
+                return dict(model["context"], sync=sync)
+            if route == "lines":
+                off = set(model["disabledPromos"])
+                lines = []
+                for account in model["context"]["accounts"]:
+                    mine = [row for row in model["groups"] if row["account"] == account["id"]]
+                    active = [row for row in mine if row["status"] == "active"]
+                    counts = {}
+                    for group in active:
+                        for slug in group["promos"]:
+                            counts[slug] = counts.get(slug, 0) + 1
+                    promos = [{"slug": slug, "count": count, "off": slug in off} for slug, count in counts.items()]
+                    promos.sort(key=lambda row: -row["count"])
+                    lines.append(dict(account, groupCount=len(mine), advertisingCount=len(active),
+                                      campaignCount=sum(not row["off"] for row in promos), promos=promos))
+                return {"lines": lines, "writes": model["context"]["writes"], "sync": sync}
+            if route == "schedule":
+                slots = [{"slug": row["slug"], "name": row["name"],
+                          "minutes": row.get("scheduleMinutes", (row["hour"] or 0) * 60 + (row["minute"] or 0)),
+                          "targetCount": row["targetCount"], "accounts": row["accounts"],
+                          **({"scheduleEdit": row["scheduleEdit"]} if row.get("scheduleEdit") else {})}
+                         for row in model["campaigns"] if row["enabled"] and row["hour"] is not None and row.get("scheduleMinutes", 0) is not None]
+                for slot in slots:
+                    slot["time"] = "%02d:%02d" % divmod(slot["minutes"], 60)
+                payload = {"date": model["date"], "timezone": "Africa/Harare", "slots": slots,
+                           "writes": model["context"]["writes"]}
+                revision = digest(payload)
+                return {"sync": sync, "revision": revision, **({"unchanged": True} if params.get("since") == revision else payload)}
+            if route == "group":
+                jid = params.get("ids", "")
+                if not group_discovery.GROUP.fullmatch(jid):
+                    raise ValueError("Invalid group.")
+                return {"group": next((row for row in model["groups"] if row["jid"] == jid), None), "sync": sync}
+            if route in ("campaign", "captions", "detail", "preview"):
+                slug = params.get("slug", "")
+                if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", slug):
+                    raise ValueError("Invalid campaign.")
+                row = next((row for row in model["campaigns"] if row["slug"] == slug), None)
+                if row is None:
+                    return {"campaign": None, "sync": sync}
+                if route == "campaign":
+                    revision = digest([row, model["context"]])
+                    return {"sync": sync, "revision": revision, **({"unchanged": True} if params.get("since") == revision
+                            else {"campaign": row, "context": model["context"]})}
+                day = datetime.date.fromisoformat(model["date"])
+                if route == "captions":
+                    records = self.bridge.campaign_records(day, only_slug=slug, include_assets=False)
+                    campaign = records[0] if records else None
+                    return {"campaign": {key: campaign[key] for key in ("slug", "name", "source")} if campaign else None,
+                            "captions": campaign["captions"] if campaign else [], "writes": model["context"]["writes"], "sync": sync}
+                if route == "detail":
+                    records = self.bridge.campaign_records(day, only_slug=slug, include_assets=True)
+                    return {"campaign": records[0] if records else None, "adAssets": self.bridge.ad_assets_status(), "sync": sync}
+                preview = self.bridge.preview(slug, day)
+                rows = preview.pop("groups")
+                return self.page("preview", rows, params, digest(preview | {"groups": rows}), sync,
+                                 {"variantCount": len(preview["captions"]), "context": model["context"]})
+            if route in ("groups", "campaigns"):
+                self.sql.create_function("matches", 1, lambda body: int(matches(route, json.loads(body), params)))
+                rows = [json.loads(body) for (body,) in self.sql.execute(
+                    "SELECT body FROM rows WHERE kind=? AND matches(body) ORDER BY position", (route,))]
+                revision = digest([model["date"], rows, model["context"], self.deletions() if route == "campaigns" else model["disabledPromos"]])
+                facets = {"lines": [a["id"] for a in model["context"]["accounts"]],
+                          "campaigns": [{"slug": c["slug"], "name": c["name"], "enabled": c["enabled"]} for c in model["campaigns"]],
+                          "tiers": list((model["context"].get("capSettings") or {}).get("bands", {"busy": [], "normal": [], "quiet": []}))}
+                return self.page(route, rows, params, revision, sync,
+                                 {"context": model["context"], "facets": facets, "disabledPromos": model["disabledPromos"],
+                                  "deletions": self.deletions() if route == "campaigns" else []})
+            raise ValueError("Unknown live view.")
+
+    def deletions(self):
+        # Cleanup receipts are synchronized alongside config, never re-queried
+        # by list polling. Older bot checkouts simply have no receipts.
+        return [{"slug": slug, "name": row.get("name", slug), "cleanup": row.get("cleanup", "pending"),
+                 "detail": row.get("detail")} for slug, row in self.index.documents("campaign_deletions")]
+
+    def page(self, kind, rows, params, revision, sync, extra):
+        key = "slug" if kind == "campaigns" else "jid"
+        signature = digest({k: v for k, v in params.items() if k not in ("cursor", "anchor", "since")})
+        offset = 0
+        if params.get("cursor"):
+            point = cursor_decode(params["cursor"])
+            if not isinstance(point, dict) or point.get("kind") != kind or point.get("query") != signature:
+                raise ValueError("Page cursor belongs to another query.")
+            if point.get("revision") != revision:
+                return {"reset": True, "sync": sync, "revision": revision}
+            offset = point.get("offset")
+            if type(offset) is not int or offset < 0:
+                raise ValueError("Invalid page cursor.")
+        elif params.get("anchor"):
+            offset = next((i for i, row in enumerate(rows) if row[key] == params["anchor"]), 0)
+        page = rows[offset:offset + PAGE_SIZE]
+        if kind == "groups":
+            page = [dict(row, note=None) for row in page]
+        next_cursor = cursor_encode({"kind": kind, "query": signature, "revision": revision, "offset": offset + PAGE_SIZE}) if offset + PAGE_SIZE < len(rows) else None
+        self.index.counters["returnedRows"] += len(page) if params.get("since") != revision else 0
+        payload = {"sync": sync, "revision": revision}
+        if params.get("since") == revision:
+            return dict(payload, unchanged=True)
+        return dict(payload, rows=page, nextCursor=next_cursor, total=len(rows), **extra)
+
+    def metrics(self, params):
+        ids = list(dict.fromkeys(params.get("ids", "").split(","))) if params.get("ids") else []
+        if len(ids) > 100 or any(not group_discovery.GROUP.fullmatch(jid) for jid in ids):
+            raise ValueError("Invalid telemetry group selection.")
+        try:
+            membership = self.index.observation_membership()
+        except console_live_index.NotReady:
+            membership = {"defaults": {"accounts": {}}}
+        payload = {"groups": [{"jid": jid} for jid in ids]}
+        group_metrics.attach(payload, membership, self.env, group_ids=ids)
+        return {"rows": payload["groups"], "sync": self.index.status()}
+
+
+def matches(kind, row, params):
+    q = params.get("q", "").strip().lower()
+    if kind == "groups":
+        haystack = " ".join([row.get("name") or "Unnamed group", row["jid"], row["jid"].removesuffix("@g.us")])
+        if params.get("ids") and row["jid"] not in params["ids"].split(","):
+            return False
+        if q not in haystack.lower():
+            return False
+        status = params.get("status", "all")
+        active = row["status"] == "active"
+        if status == "advertising" and (not active or not row["promos"]) or status == "needs-decision" and active:
+            return False
+        if status == "no-campaign" and (not active or row["promos"]):
+            return False
+        if status not in ("all", "advertising", "needs-decision", "no-campaign") and row["status"] != status:
+            return False
+        return (not params.get("line") or row["account"] == params["line"]) and (not params.get("tier") or row["activity"] == params["tier"]) and (not params.get("campaign") or params["campaign"] in row["promos"])
+    haystack = " ".join([title(row["slug"]), row["slug"], row["name"] or "", (row.get("tracking") or {}).get("prefix", "")])
+    running = row["enabled"] and not row.get("error")
+    status = params.get("status", "all")
+    if q not in haystack.lower() or status == "running" and not running or status == "off" and row["enabled"] or status == "failing" and not row.get("error") or status == "no-groups" and (not running or row["targetCount"]):
+        return False
+    hour = row.get("hour")
+    slot = "unscheduled" if hour is None else "morning" if hour < 12 else "afternoon" if hour < 17 else "evening"
+    return (not params.get("line") or params["line"] in row["accounts"]) and (not params.get("cadence") or (row["weeklyCount"] > 0) == (params["cadence"] == "weekly")) and (not params.get("slot") or params["slot"] == slot)
diff --git a/workspace/lib/console_live_index.py b/workspace/lib/console_live_index.py
new file mode 100644
index 0000000..c41dc40
--- /dev/null
+++ b/workspace/lib/console_live_index.py
@@ -0,0 +1,322 @@
+"""Durable, display-only Firestore index. Never imported by writers or sends.
+
+The single API process owns the leased stream. Readers open independent SQLite
+snapshots. Documents and resume positions publish together, never mid-bootstrap.
+"""
+import contextlib
+import datetime
+import hashlib
+import json
+import os
+import sqlite3
+import threading
+import time
+
+import operator_config as config
+
+SCHEMA = 2
+COLLECTIONS = ("settings", "lines", "campaigns", "groups", "campaign_deletions")
+LEASE_SECONDS = 90
+
+
+class NotReady(Exception):
+    pass
+
+
+def identity(env):
+    creds = config.credentials(env)
+    if not creds:
+        raise config.ConfigUnavailable("no service account configured")
+    return hashlib.sha256(json.dumps([SCHEMA, config.API_ROOT, creds], sort_keys=True).encode()).hexdigest()
+
+
+class Index:
+    def __init__(self, env=None, *, clock=time.time, stream=None):
+        self.env = dict(os.environ if env is None else env)
+        self.clock = clock
+        self.identity = identity(self.env)
+        self.path = os.path.join(config.state_dir(self.env), "console-live.sqlite")
+        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
+        self.lock = threading.RLock()
+        self.condition = threading.Condition(self.lock)
+        self.lease_until = 0
+        self.stopped = False
+        self.thread = None
+        self.cancel = None
+        self.stream = stream or firestore_stream
+        self.error = None
+        self.connected = False
+        self.counters = {"syncDocuments": 0, "rebuilds": 0, "activeStreams": 0,
+                         "indexedRequests": 0, "returnedRows": 0}
+        fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
+        os.close(fd)
+        with self.db() as db:
+            version = db.execute("PRAGMA user_version").fetchone()[0]
+            if version != SCHEMA:
+                db.execute("DROP TABLE IF EXISTS docs")
+                db.execute("DROP TABLE IF EXISTS meta")
+            db.execute("PRAGMA user_version=%d" % SCHEMA)
+            db.executescript("""
+              PRAGMA journal_mode=WAL;
+              CREATE TABLE IF NOT EXISTS meta (id INTEGER PRIMARY KEY CHECK(id=1), identity TEXT,
+                generation INTEGER, revision INTEGER, read_time TEXT, tokens TEXT);
+              CREATE TABLE IF NOT EXISTS docs (generation INTEGER, collection TEXT, id TEXT, body TEXT,
+                PRIMARY KEY(generation, collection, id));
+            """)
+            row = db.execute("SELECT identity FROM meta WHERE id=1").fetchone()
+            if row is None or row[0] != self.identity:
+                db.execute("DELETE FROM docs")
+                db.execute("DELETE FROM meta")
+                db.execute("INSERT INTO meta VALUES(1,?,0,0,NULL,'{}')", (self.identity,))
+            db.execute("DELETE FROM docs WHERE generation != (SELECT generation FROM meta WHERE id=1)")
+        os.chmod(self.path, 0o600)
+
+    @contextlib.contextmanager
+    def db(self):
+        db = sqlite3.connect(self.path, timeout=5)
+        try:
+            with db:
+                yield db
+        finally:
+            db.close()
+
+    def checkpoint(self):
+        with self.db() as db:
+            generation, revision, stamp, tokens = db.execute(
+                "SELECT generation,revision,read_time,tokens FROM meta WHERE id=1").fetchone()
+        return {"generation": generation, "revision": revision, "readTime": stamp, "tokens": json.loads(tokens)}
+
+    def touch(self):
+        with self.condition:
+            self.lease_until = self.clock() + LEASE_SECONDS
+            if self.thread is None:
+                self.thread = threading.Thread(target=self._run, name="console-index", daemon=True)
+                self.thread.start()
+            self.condition.notify_all()
+
+    def status(self):
+        point = self.checkpoint()
+        stamp = point["readTime"]
+        lag = max(0, self.clock() - datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp()) if stamp else None
+        return {"revision": str(point["revision"]), "syncedAt": stamp, "lagSeconds": lag,
+                "stale": not self.connected or bool(self.error),
+                "state": "syncing" if not point["readTime"] else "stale" if not self.connected or self.error else "live"}
+
+    def documents(self, collection):
+        with self.db() as db:
+            return [(name, config.decode_fields(json.loads(body))) for name, body in db.execute(
+                "SELECT id,body FROM docs WHERE generation=(SELECT generation FROM meta WHERE id=1) AND collection=? ORDER BY id", (collection,))]
+
+    def observation_membership(self, include_ids=False):
+        """Telemetry needs account numbers; discovery additionally needs IDs only."""
+        raw = {collection: [] for collection in COLLECTIONS}
+        with self.db() as db:
+            db.execute("BEGIN")
+            generation, stamp = db.execute("SELECT generation,read_time FROM meta WHERE id=1").fetchone()
+            if not stamp:
+                raise NotReady("The display index is synchronizing.")
+            for collection, name, body in db.execute(
+                    "SELECT collection,id,body FROM docs WHERE generation=? AND collection IN ('settings','lines')", (generation,)):
+                raw[collection].append((name, json.loads(body)))
+            membership = config.assemble(raw)[0]
+            if include_ids:
+                membership["groups"] = {name: {} for (name,) in db.execute(
+                    "SELECT id FROM docs WHERE generation=? AND collection='groups'", (generation,))}
+        return membership
+
+    def snapshot(self):
+        with self.db() as db:
+            db.execute("BEGIN")
+            generation, revision, stamp = db.execute(
+                "SELECT generation,revision,read_time FROM meta WHERE id=1").fetchone()
+            if not stamp:
+                raise NotReady("The display index is synchronizing. Try again shortly.")
+            raw = {collection: [] for collection in COLLECTIONS}
+            for collection, name, body in db.execute(
+                    "SELECT collection,id,body FROM docs WHERE generation=? ORDER BY collection,id", (generation,)):
+                raw[collection].append((name, json.loads(body)))
+        import campaign_deletion
+        deleted = sorted(campaign_deletion.deleted_slugs(raw))
+        membership, enabled, undecodable = config.assemble(raw)
+        membership, report = config.quarantine(membership, undecodable)
+        enabled, report["campaigns"] = config.campaign_switches(enabled)
+        return {"source": "snapshot", "membership": membership, "enabled": enabled,
+                "report": report, "fetchedAt": stamp, "degraded": None, "deleted": deleted}, str(revision)
+
+    def publish(self, changes, read_time, tokens, *, reset=False):
+        """Called only at a global consistent stream boundary."""
+        with self.lock, self.db() as db:
+            generation, revision = db.execute("SELECT generation,revision FROM meta WHERE id=1").fetchone()
+            if reset:
+                generation += 1
+                self.counters["rebuilds"] += 1
+            changed = reset
+            for collection, name, fields in changes:
+                if collection not in COLLECTIONS:
+                    raise ValueError("unexpected index collection")
+                previous = db.execute("SELECT body FROM docs WHERE generation=? AND collection=? AND id=?",
+                                      (generation, collection, name)).fetchone()
+                body = json.dumps(fields, sort_keys=True) if fields is not None else None
+                if (previous[0] if previous else None) == body:
+                    continue
+                changed = True
+                if fields is None:
+                    db.execute("DELETE FROM docs WHERE generation=? AND collection=? AND id=?", (generation, collection, name))
+                else:
+                    db.execute("INSERT OR REPLACE INTO docs VALUES(?,?,?,?)", (generation, collection, name, body))
+            # Validate shared configuration before making this generation visible.
+            raw = {collection: [] for collection in COLLECTIONS}
+            for collection, name, body in db.execute("SELECT collection,id,body FROM docs WHERE generation=?", (generation,)):
+                raw[collection].append((name, json.loads(body)))
+            membership, enabled, undecodable = config.assemble(raw)
+            config.quarantine(membership, undecodable)
+            config.campaign_switches(enabled)
+            db.execute("UPDATE meta SET generation=?,revision=?,read_time=?,tokens=? WHERE id=1",
+                       (generation, revision + int(changed), read_time, json.dumps(tokens)))
+            db.execute("DELETE FROM docs WHERE generation != ?", (generation,))
+        self.error = None
+
+    def _run(self):
+        delay = 1
+        while True:
+            with self.condition:
+                while not self.stopped and self.clock() >= self.lease_until:
+                    self.connected = False
+                    self.condition.wait(1)
+                if self.stopped:
+                    return
+            try:
+                self.counters["activeStreams"] = 1
+                self.stream(self)
+                delay = 1
+            except Exception as exc:
+                # Curated status only. Exception text may contain credential context.
+                self.error = type(exc).__name__
+                self.connected = False
+                with self.condition:
+                    self.condition.wait(delay)
+                delay = min(delay * 2, 300)
+            finally:
+                self.counters["activeStreams"] = 0
+
+    def close(self):
+        with self.condition:
+            self.stopped = True
+            if self.cancel:
+                self.cancel()
+            self.condition.notify_all()
+        if self.thread:
+            self.thread.join(5)
+
+
+def firestore_stream(index):
+    """Public Listen RPC, with durable resume tokens and an idle cancellation timer."""
+    import base64
+    from google.cloud.firestore_v1.services.firestore import FirestoreClient
+    from google.cloud.firestore_v1.types import ListenRequest, Target
+    from google.oauth2 import service_account
+    from google.protobuf.json_format import MessageToDict
+    from google.protobuf.timestamp_pb2 import Timestamp
+    from google.api_core.exceptions import InvalidArgument, FailedPrecondition
+
+    creds = config.credentials(index.env)
+    client = FirestoreClient(credentials=service_account.Credentials.from_service_account_info(creds))
+    database = "projects/%s/databases/(default)" % creds["project_id"]
+    point = index.checkpoint()
+    bootstrap = not point["readTime"] or point["tokens"].get("reset", False)
+    tokens = {} if bootstrap else point["tokens"].copy()
+    requests = []
+    for number, collection in enumerate(COLLECTIONS, 1):
+        target = Target(target_id=number, query={"parent": database + "/documents",
+                        "structured_query": {"from_": [{"collection_id": collection}]}})
+        if not bootstrap:
+            if str(number) in tokens:
+                target.resume_token = base64.b64decode(tokens[str(number)])
+            else:
+                stamp = Timestamp()
+                stamp.FromJsonString(point["readTime"])
+                target.read_time = stamp
+        requests.append(ListenRequest(database=database, add_target=target))
+    # Keep the bidirectional request stream open after adding the targets.
+    done = threading.Event()
+    def request_iter():
+        yield from requests
+        done.wait()
+    response = None
+    def cancel():
+        if response is not None:
+            response.cancel()
+        else:
+            client.transport.close()
+    index.cancel = cancel
+    def monitor():
+        while not done.wait(0.5):
+            if index.stopped or index.clock() >= index.lease_until:
+                cancel()
+                return
+    threading.Thread(target=monitor, daemon=True).start()
+    pending = []
+    known = {collection: set() if bootstrap else {name for name, _ in index.documents(collection)} for collection in COLLECTIONS}
+    current = set()
+    try:
+        response = client.listen(requests=request_iter(), retry=None,
+                                 metadata=(("google-cloud-resource-prefix", database),))
+        for change in response:
+            kind = change._pb.WhichOneof("response_type")
+            if kind == "document_change":
+                doc = change.document_change.document
+                collection, name = doc.name.rsplit("/", 2)[-2:]
+                known[collection].add(name)
+                pending.append((collection, name, MessageToDict(doc._pb).get("fields", {})))
+                index.counters["syncDocuments"] += 1
+            elif kind in ("document_delete", "document_remove"):
+                # An unfiltered collection target has no legitimate remove-only
+                # event except a reset; a reset rebuilds the entire generation.
+                document = getattr(change, kind).document
+                collection, name = document.rsplit("/", 2)[-2:]
+                known[collection].discard(name)
+                pending.append((collection, name, None))
+            elif kind == "filter":
+                number = change.filter.target_id
+                if not 1 <= number <= len(COLLECTIONS) or len(known[COLLECTIONS[number - 1]]) != change.filter.count:
+                    # Only a mismatch requires a rebuild; normal existence
+                    # filters must never trigger a repeat collection bootstrap.
+                    raise ResetRequired()
+            elif kind == "target_change":
+                target = change.target_change
+                ids = list(target.target_ids) or list(range(1, len(COLLECTIONS) + 1))
+                state = int(target.target_change_type)
+                if state == 2:
+                    raise config.ConfigUnavailable("index target refused")
+                if state == 4:
+                    raise ResetRequired()
+                if state == 3:
+                    current.update(ids)
+                if target.resume_token:
+                    for number in ids:
+                        tokens[str(number)] = base64.b64encode(target.resume_token).decode()
+                if target.read_time and not target.target_ids and current == set(range(1, len(COLLECTIONS) + 1)):
+                    stamp = target._pb.read_time.ToJsonString()
+                    index.publish(pending, stamp, tokens, reset=bootstrap)
+                    pending = []
+                    bootstrap = False
+                    index.connected = True
+    except (ResetRequired, InvalidArgument, FailedPrecondition):
+        # Forget resume positions only. Keep the published generation readable
+        # until a replacement has reached CURRENT for every collection.
+        with index.db() as db:
+            db.execute("UPDATE meta SET tokens=? WHERE id=1", (json.dumps({"reset": True}),))
+        raise
+    except Exception:
+        if not index.stopped and index.clock() < index.lease_until:
+            raise
+    finally:
+        done.set()
+        cancel()
+        index.cancel = None
+        index.connected = False
+        client.transport.close()
+
+
+class ResetRequired(Exception):
+    pass
