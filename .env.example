# --- workspaces and their bots ---------------------------------------------
# No variable names a bot. Each signed-in user's workspace names its own bot in
# the registry (consoleUsers/{uid}, workspaces/{id} in Firestore), and the console
# calls it with a token derived from this secret: HMAC-SHA256(secret,
# "genaie-bot:" + workspace id). Each bot holds its derived value as
# CONSOLE_API_TOKEN (scripts/workspace-admin.mjs token --workspace <id>).
# At least 32 characters; server only, never NEXT_PUBLIC_. Changing it changes
# every bot's token.
BOT_TOKEN_SECRET=

# Development only: BOT_SOURCE=local runs the bridges from a genaebot checkout
# for the signed-in user's workspace instead of calling its bot. Ignored in
# production. Keep the checkout current with origin/main: a checkout behind
# main serves an older payload than the screens expect.
BOT_SOURCE=
GENAEBOT_CHECKOUT=/home/joseph/projects/genaebot

# Whether /setup can create a workspace's bot itself.
#   railway  build one for real: its own Railway service, volume and domain.
#            Needs every BOT_RAILWAY_* and BOT_IMAGE value below, or it falls
#            back to none and /setup says creating a bot is not available.
#   stub     walk the screen through its stages without building anything.
#            Development only; ignored in production.
#   unset    a bot is created by hand (docs/provision-bot.md).
BOT_PROVISIONING=

# --- creating a bot on Railway (BOT_PROVISIONING=railway) -------------------
# Every name here is prefixed BOT_, the Railway ones included, because Railway
# injects RAILWAY_PROJECT_ID and RAILWAY_ENVIRONMENT_ID into every service it
# runs: a console deployed on Railway would otherwise read its OWN ids from
# those names and create each user's bot inside the console's own project.
#
# The token creates and deletes services: a bot is built with it from /setup,
# and deleted with it, volume and all, when its account is deleted. Without it a
# console refuses to delete an account whose bot it built, rather than leave the
# bot running. Server only, never NEXT_PUBLIC_.
BOT_RAILWAY_API_TOKEN=
# The project and environment the BOTS live in, not the console's own.
BOT_RAILWAY_PROJECT_ID=
BOT_RAILWAY_ENVIRONMENT_ID=
# The service a new bot copies its shared values from: the Firestore keys, R2,
# the model keys. The console reads them from Railway at provision time and
# writes them onto the new service, so it keeps no copy of them itself. A SEALED
# Railway variable cannot be read back, so anything a bot cannot work without
# must not be sealed -- a run refuses up front and names it rather than building
# a bot that can serve nothing.
BOT_TEMPLATE_SERVICE_ID=
# The published bot image, by exact tag, from genaebot's release pipeline.
BOT_IMAGE=
# Rolling each genaebot release out to every console-built bot
# (docs/provision-bot.md, "Releases reach every bot"). Two tokens, each at
# least 32 characters and different: genaebot's release job holds the first,
# the console repo's fleet-tick workflow the second. Unset, both routes answer
# 401 and bots keep the image they have.
FLEET_RELEASE_TOKEN=
FLEET_TICK_TOKEN=
# Only for a private package; both or neither. Server only.
BOT_IMAGE_REGISTRY_USERNAME=
BOT_IMAGE_REGISTRY_PASSWORD=
# The bot's state volume, region and console-API port. The defaults are the
# running bot's own, so a deployment that sets none of them matches it.
BOT_VOLUME_MOUNT_PATH=/home/joseph/.openclaw
BOT_RAILWAY_REGION=europe-west4-drams3a
BOT_CONSOLE_API_PORT=18790
# Which tree a new workspace's settings/defaults is copied from: root, or
# workspace:<id> once the root install is retired. Same vocabulary as genaebot's
# deploy/init-workspace.py --settings-from. This is the one document the console
# writes into a workspace's own data, and it needs Cloud Datastore User (which
# the registry credential below already has).
BOT_SETTINGS_TEMPLATE=root

# Development only: a bot origin the stub's last stage really connects to, so a
# finished run leaves a working console. Unset, the run is simulated and the
# screen says so. Must be a bare origin, https or loopback http.
BOT_PROVISIONING_STUB_URL=

# The master switch for editing. All requests require Google sign-in; this
# switch and the bot's reported capabilities independently control writes.
# Unset means every screen is read-only. Authentication does not enable writes.
#
# This is only the console's half. The bot reports separately whether it holds
# a write key and which fields it accepts (overview.writes), and every control
# gates on both: with CONSOLE_WRITES=1 but no key on the bot, controls say so.
CONSOLE_WRITES=

# Caption assistant: server-only OpenRouter key. Uses the same model as the bot,
# deepseek/deepseek-v4.1-flash-1017. Never prefix this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Link/Unlink/Pause/Start always require the live console API, including for a
# local UI. Deploy genaebot's companion account-control changes first.
# Gateway credentials stay in the gateway container, never in NEXT_PUBLIC_* vars.

# Browser-to-R2 campaign picture uploads, and deleting a workspace's pictures
# (everything under w/<id>/) when its account is deleted. Credentials stay on the
# console server. Use an Object Read & Write token scoped to this bucket: it
# signs puts, and lists and deletes on account deletion. Never NEXT_PUBLIC_*.
# The bot keeps its existing GENAIE_AD_ASSETS_BASE_URL and read credentials.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Firebase Google authentication ------------------------------------------
# Public web-app configuration from Firebase Console > Project settings.
# These NEXT_PUBLIC values are compiled into the browser bundle; rebuild after
# changing them. Auth users are shared by all apps in this Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=database-8982a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=database-8982a
NEXT_PUBLIC_FIREBASE_APP_ID=1:766882916139:web:8733489a96e8e6dbce076e

# Server only. This project must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# The service account needs Firebase Authentication Admin and, for the
# workspace registry, Cloud Datastore User.
FIREBASE_PROJECT_ID=database-8982a
FIREBASE_CLIENT_EMAIL=
# PEM key; literal \n sequences are supported. Never NEXT_PUBLIC_.
FIREBASE_PRIVATE_KEY=
# Alternatively, use ADC (local path to a service-account JSON, kept outside git).
GOOGLE_APPLICATION_CREDENTIALS=
# Exact browser-facing origin (no path). Production must use HTTPS.
APP_ORIGIN=http://localhost:3000

# Local Auth Emulator only: set both values to matching loopback addresses.
# Leave unset for real Google sign-in. Rejected when NODE_ENV=production.
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
