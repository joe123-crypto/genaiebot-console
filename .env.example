# Path to a genaebot checkout. Used only by the local (development) adapter,
# which runs that checkout's workspace/bin/console-read.
GENAEBOT_CHECKOUT=/home/joseph/projects/genaebot

# Console API beside the gateway. Setting the base URL switches the console to
# the remote adapter, which then wins over the local one. The token must match
# CONSOLE_API_TOKEN on the bot.
#
# Set both. Reading the live API is the same path a deployed console takes, so
# development and production cannot disagree. Leave them empty only to shell
# out to the checkout above, and then keep it current with origin/main: a
# checkout behind main serves an older payload than the screens expect, which
# is a stale read, not an outage.
BOT_API_BASE_URL=
BOT_API_TOKEN=

# --- writes -----------------------------------------------------------------
# Deleting a group is the console's first write. It goes to a separate service
# for canonical group/campaign edits, so it has its own base URL and token.
# WhatsApp account operations use the live gateway API configured above.
#
# Leave BOT_WRITE_API_BASE_URL empty and writes go through
# $GENAEBOT_CHECKOUT/workspace/bin/console-write instead, the same way reads
# fall back to the local bridge.
BOT_WRITE_API_BASE_URL=
BOT_WRITE_TOKEN=

# The master switch, and for now the ONLY thing standing between a visitor and
# a delete: the console still has no login. Unset means every screen is
# read-only, which is what a deployed console should stay until there is
# authentication in front of it. Set it to 1 only where that is understood.
CONSOLE_WRITES=

# Link/Unlink/Pause/Start always require the live console API, including for a
# local UI. Deploy genaebot's companion account-control changes first.
# Gateway credentials stay in the gateway container, never in NEXT_PUBLIC_* vars.
