# Path to a genaebot checkout. Used only by the local (development) adapter,
# which runs that checkout's workspace/bin/console-read.
GENAEBOT_CHECKOUT=/home/joseph/projects/genaebot

# Console API beside the gateway. Setting the base URL switches the console to
# the remote adapter, which then wins over the local one. The token must match
# CONSOLE_API_TOKEN on the bot.
#
# Set both. Reading the live API is the same path a deployed console takes, so
# development and production cannot disagree. Leave them empty only to shell
# out to the checkout above, and then keep it current with origin/main: a
# checkout behind main serves an older payload than the screens expect, which
# is a stale read, not an outage.
BOT_API_BASE_URL=
BOT_API_TOKEN=
