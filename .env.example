# Path to a genaebot checkout. Used only by the local (development) adapter,
# which runs that checkout's workspace/bin/console-read.
GENAEBOT_CHECKOUT=/home/joseph/projects/genaebot

# Console API beside the gateway. Setting the base URL switches the console to
# the remote adapter, which then wins over the local one. The token must match
# CONSOLE_API_TOKEN on the bot.
#
# Set both. Reading the live API is the same path a deployed console takes, so
# development and production cannot disagree. Leave them empty only to shell
# out to the checkout above, and then keep it current with origin/main: a
# checkout behind main serves an older payload than the screens expect, which
# is a stale read, not an outage.
BOT_API_BASE_URL=
BOT_API_TOKEN=

# --- writes -----------------------------------------------------------------
# Config edits (groups, lines, campaign switches, cap settings) go to the same
# console API as the reads, on its POST config/<collection>/<id> route, with the
# same token. So nothing extra is needed: leave these two empty and writes go
# wherever the reads above go -- remote with the read token, or the local
# checkout's console-write when the reads are local.
#
# Set them only to send writes to a different bot on purpose. The read token is
# never sent to a different write host; give that host its own token.
BOT_WRITE_API_BASE_URL=
BOT_WRITE_TOKEN=

# The master switch for editing. All requests require Google sign-in; this
# switch and the bot's reported capabilities independently control writes.
# Unset means every screen is read-only. Authentication does not enable writes.
#
# This is only the console's half. The bot reports separately whether it holds
# a write key and which fields it accepts (overview.writes), and every control
# gates on both: with CONSOLE_WRITES=1 but no key on the bot, controls say so.
CONSOLE_WRITES=

# Caption assistant: server-only OpenRouter key. Uses the same model as the bot,
# deepseek/deepseek-v4.1-flash-1017. Never prefix this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Link/Unlink/Pause/Start always require the live console API, including for a
# local UI. Deploy genaebot's companion account-control changes first.
# Gateway credentials stay in the gateway container, never in NEXT_PUBLIC_* vars.

# Browser-to-R2 campaign picture uploads. Credentials stay on the console server.
# Use a token scoped to object writes in this bucket; never NEXT_PUBLIC_*.
# The bot keeps its existing GENAIE_AD_ASSETS_BASE_URL and read credentials.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Firebase Google authentication ------------------------------------------
# Public web-app configuration from Firebase Console > Project settings.
# These NEXT_PUBLIC values are compiled into the browser bundle; rebuild after
# changing them. Auth users are shared by all apps in this Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=database-8982a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=database-8982a
NEXT_PUBLIC_FIREBASE_APP_ID=1:766882916139:web:8733489a96e8e6dbce076e

# Server only. This project must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=database-8982a
FIREBASE_CLIENT_EMAIL=
# PEM key; literal \n sequences are supported. Never NEXT_PUBLIC_.
FIREBASE_PRIVATE_KEY=
# Alternatively, use ADC (local path to a service-account JSON, kept outside git).
GOOGLE_APPLICATION_CREDENTIALS=
# Exact browser-facing origin (no path). Production must use HTTPS.
APP_ORIGIN=http://localhost:3000

# Local Auth Emulator only: set both values to matching loopback addresses.
# Leave unset for real Google sign-in. Rejected when NODE_ENV=production.
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
